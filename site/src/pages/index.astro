---
import Layout from '../layouts/Layout.astro';

// The homepage leads with the labs. Tools, lessons and the dictionary stay in their own directories,
// reached from the nav, the resources row and the footer.
const INVESTIGATE = [
  { href: '/prompt-diff', name: 'Prompt Diff', desc: 'See exactly what changed between two versions of a prompt.' },
  { href: '/context-window-visualizer', name: 'Context Window Visualizer', desc: 'See what is using up a model’s context budget.' },
  { href: '/structured-output-builder', name: 'Structured Output Builder', desc: 'Define the output your application expects, as a schema.' },
];
const MORE = [
  { href: '/learn', name: 'Learning paths' },
  { href: '/reference', name: 'Knowledge Base' },
  { href: '/ai', name: 'AI Explained' },
  { href: '/dictionary', name: 'Dictionary' },
];
---
<Layout
  title="KB Cafe, the interactive AI knowledge base"
  description="KB Cafe is a free AI knowledge base for developers. Hands-on browser labs teach you to recover when AI breaks something and verify when AI says it works."
  path="/"
  bodyClass="home"
>
  <!-- HERO (value-prop) -->
  <section class="hero-redo">
    <h1 class="hr-title">Learn to fix<br><span class="hr-grad">what AI builds.</span></h1>
    {/* The subhead opens with a plain "X is a Y" sentence, and that is the fix rather than a style
        change. Asked what this site is, Google AI Mode answered "coffee-related businesses" (measured
        2026-08-13), because the headline is a promise and nothing on the page said what KB Cafe IS.
        The category sentence goes first, in the position an engine weighs most. */}
    <p class="hr-sub"><strong>KB Cafe is a free AI knowledge base for developers.</strong> Its hands-on labs teach you to recover when AI damages something and verify when AI says something works, right in your browser.</p>
    <div class="hr-cta">
      <a class="hr-btn hr-btn-pri" href="/blog/ai-agent-blanked-26-files#recovery-lab">Try a recovery lab <span aria-hidden="true">&rarr;</span></a>
      <a class="hr-btn hr-btn-gho" href="#labs">Explore the labs</a>
    </div>
    <a class="hr-due" id="hr-due" href="/flashcards" hidden></a>
  </section>

  <!-- The labs: "fix what AI builds", each drawn from a real incident -->
  <section class="lab-feat" id="labs" aria-labelledby="lab-feat-h">
    <div class="lf-head">
      <span class="lf-eye">Hands-on labs</span>
      <h2 id="lab-feat-h">Two failures you can practice on</h2>
      <p>Each lab runs in your browser on sample data, with no signup.</p>
    </div>
    <div class="lf-grid">
      <article class="lf-card">
        <h3>Your AI agent just blanked your files. Can you get them back?</h3>
        <p>Find the damage on a sample project, restore what you can, and prove it came back.</p>
        <pre class="lf-term" aria-hidden="true"><code>$ git restore src/pages/dns.astro
error: pathspec 'src/pages/dns.astro'
did not match any file(s) known to git</code></pre>
        <div class="lf-cta">
          <a class="hr-btn hr-btn-pri" href="/blog/ai-agent-blanked-26-files#recovery-lab">Start the lab <span aria-hidden="true">&rarr;</span></a>
          <a class="hr-btn hr-btn-gho" href="/blog/ai-agent-blanked-26-files">Read what happened</a>
        </div>
      </article>
      <article class="lf-card">
        <h3>Your test passed. Can it actually fail?</h3>
        <p>Plant a forbidden word, watch the guard miss it, find the invisible character, and repair the regex.</p>
        <pre class="lf-term" aria-hidden="true"><code>$ cat -A guard.test.js
/^Hagents?^H/i
$ node --test guard.test.js
# pass 1  # fail 0</code></pre>
        <div class="lf-cta">
          <a class="hr-btn hr-btn-pri" href="/blog/the-test-that-could-never-fail#guard-lab">Start the lab <span aria-hidden="true">&rarr;</span></a>
          <a class="hr-btn hr-btn-gho" href="/blog/the-test-that-could-never-fail">Read what happened</a>
        </div>
      </article>
    </div>
  </section>

  <section class="hm-why" aria-labelledby="hm-why-h">
    <h2 id="hm-why-h">Why these labs exist</h2>
    <p>Both come from real failures on projects built with AI agents. Each write-up separates what the record shows from what the lab reconstructs, and says what could not be checked.</p>
  </section>

  <section class="hm-tools" aria-labelledby="hm-tools-h">
    <div class="hm-tools-head">
      <h2 id="hm-tools-h">Tools to help you investigate</h2>
      <a class="hm-all" href="/tools">Browse all tools <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="hm-tool-grid">
      {INVESTIGATE.map(t => (
        <a class="hm-tool" href={t.href}>
          <h3>{t.name}</h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>
    <nav class="hm-more" aria-label="More to read">
      <span>Keep learning:</span>
      {MORE.map(m => <a href={m.href}>{m.name}</a>)}
    </nav>
  </section>

  <script is:inline>
    // flashcards return-loop: show "N cards due to review" only if the visitor has overdue cards
    try{
      var s = JSON.parse(localStorage.getItem('kb-fc') || '{}'), due = 0, now = Date.now();
      for(var d in s){ for(var i in s[d]){ if(s[d][i][1] <= now) due++; } }
      if(due > 0){ var dueEl = document.getElementById('hr-due'); dueEl.innerHTML = '⏱ ' + due + ' flashcard' + (due>1?'s':'') + ' due to review →'; dueEl.hidden = false; }
    }catch(e){}
  </script>
</Layout>

<style is:global>
  /* homepage warm-editorial palette (scoped to the homepage; rest of the site untouched) */
  body.home{
    --line:#E7E2DB; --cream:#FFFDFA;
    background:
      radial-gradient(circle at 18% -2%, rgba(255,201,120,.12), transparent 32%),
      radial-gradient(circle at 92% 10%, rgba(238,75,43,.045), transparent 26%),
      #FAF7F1 fixed;
  }
</style>

<style>
  /* value-prop hero */
  .hero-redo{text-align:center;margin:46px 0 0}
  .hr-title{font-family:var(--font-display);font-weight:800;letter-spacing:-.035em;line-height:1.02;font-size:clamp(38px,6vw,66px);color:var(--ink);margin:0}
  .hr-grad{background:linear-gradient(100deg,var(--coral),var(--orange) 55%,var(--gold));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .hr-sub{max-width:600px;margin:20px auto 0;font-size:17.5px;line-height:1.55;color:var(--ink-soft)}
  .hr-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:26px}
  .hr-btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--font-display);font-weight:800;font-size:15px;border-radius:14px;padding:14px 24px;text-decoration:none;transition:transform .16s,box-shadow .16s,border-color .16s}
  .hr-btn-pri{background:linear-gradient(135deg,#ff5839,#e23a1d);color:#fff;box-shadow:0 12px 26px rgba(226,58,29,.26)}
  .hr-btn-pri:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(226,58,29,.32)}
  .hr-btn-gho{background:var(--cream);color:var(--ink);border:1.4px solid var(--line)}
  .hr-btn-gho:hover{transform:translateY(-2px);border-color:var(--ink)}
  .hr-due[hidden]{display:none}
  .hr-due{display:inline-flex;align-items:center;gap:8px;margin-top:16px;font-family:var(--font-display);font-weight:700;font-size:14px;color:var(--ink);background:var(--cream);border:1.4px solid var(--line);border-radius:999px;padding:8px 16px;text-decoration:none;transition:transform .15s,border-color .15s}
  .hr-due:hover{transform:translateY(-2px);border-color:var(--coral);color:var(--coral)}

  /* the labs */
  .lab-feat{scroll-margin-top:84px;max-width:1120px;margin:40px auto 0;padding:28px;border:1.4px solid var(--line);border-radius:22px;background:var(--cream);box-shadow:0 14px 40px rgba(45,30,16,.07)}
  .lf-head{max-width:720px;margin-bottom:22px}
  .lf-eye{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--coral)}
  .lab-feat h2{margin:10px 0 10px;font-family:var(--font-display);font-weight:800;font-size:clamp(25px,3.2vw,36px);line-height:1.1;letter-spacing:-.025em}
  .lab-feat p{margin:0;font-size:16px;line-height:1.55;color:var(--ink-soft)}
  .lf-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .lf-card{display:flex;flex-direction:column;gap:14px;min-width:0;padding:20px;border:1.2px solid var(--line);border-radius:16px;background:#fff}
  .lab-feat h3{margin:0;font-family:var(--font-display);font-weight:800;font-size:21px;line-height:1.2;letter-spacing:-.015em}
  .lf-cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto}
  .lf-term{margin:0;padding:14px 16px;border-radius:12px;background:#141210;color:#e7dfd1;font:12.5px/1.65 var(--font-mono);white-space:pre-wrap;overflow-wrap:anywhere}
  @media (max-width:780px){.lab-feat{padding:20px}.lf-grid{grid-template-columns:1fr}}

  /* why the labs exist */
  .hm-why{max-width:720px;margin:44px auto 0;text-align:center}
  .hm-why h2,.hm-tools h2{margin:0;font-family:var(--font-display);font-weight:800;font-size:clamp(22px,2.6vw,27px);letter-spacing:-.02em;color:var(--ink)}
  .hm-why p{margin:10px 0 0;font-size:16.5px;line-height:1.6;color:var(--ink-soft)}

  /* supporting tools and directories */
  .hm-tools{max-width:1120px;margin:44px auto 40px}
  .hm-tools-head{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;margin-bottom:16px}
  .hm-all{font-family:var(--font-display);font-weight:800;font-size:14.5px;color:var(--ink);text-decoration:none;white-space:nowrap}
  .hm-all:hover{color:var(--coral)}
  .hm-tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .hm-tool{display:block;min-width:0;padding:16px 18px;border:1.2px solid var(--line);border-radius:14px;background:var(--cream);text-decoration:none;transition:transform .15s,border-color .15s}
  .hm-tool:hover{transform:translateY(-2px);border-color:var(--coral)}
  .hm-tool h3{margin:0 0 4px;font-family:var(--font-display);font-weight:800;font-size:16px;letter-spacing:-.01em;color:var(--ink)}
  .hm-tool p{margin:0;font-size:14px;line-height:1.45;color:var(--ink-soft)}
  .hm-more{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:18px;font-size:14px;color:var(--ink-soft)}
  .hm-more a{color:var(--ink);font-weight:600;text-underline-offset:3px}
  .hm-more a:hover{color:var(--coral)}
  @media (max-width:780px){.hm-tool-grid{grid-template-columns:1fr}}
</style>
